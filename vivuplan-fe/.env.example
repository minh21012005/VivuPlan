# Frontend API
NEXT_PUBLIC_API_URL=http://localhost:8080

# Optional public app metadata
NEXT_PUBLIC_APP_NAME=VivuPlan
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional hotel affiliate search URL template.
# Supported tokens: {hotel}, {location}, {destination}, {checkin}, {checkout}, {guests}
# NEXT_PUBLIC_HOTEL_AFFILIATE_URL_TEMPLATE=https://www.booking.com/searchresults.html?ss={hotel}%20{destination}&checkin={checkin}&checkout={checkout}&group_adults={guests}

# Google OAuth
# Browser-safe client id only. Keep GOOGLE_CLIENT_SECRET on the backend.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
