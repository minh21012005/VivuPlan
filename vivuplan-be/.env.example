# Server
PORT=8080
CORS_ORIGINS=http://localhost:3000,https://vivuplan.vn

# Database
DB_URL=jdbc:postgresql://localhost:5432/vivuplan
DB_USERNAME=postgres
DB_PASSWORD=change-me

# JWT
JWT_SECRET=change-me-to-a-long-random-secret

# Admin
# The first account registered with this email will be created as ADMIN.
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
DATA_INITIALIZER_ENABLED=true

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI providers
GEMINI_API_KEY=
OPENAI_API_KEY=
