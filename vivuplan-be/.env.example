# Server
PORT=8080
CORS_ORIGINS=http://localhost:3000,https://vivuplan.xyz

# Database
DB_URL=jdbc:postgresql://localhost:5432/vivuplan
DB_USERNAME=postgres
DB_PASSWORD=your-database-password

# JWT
JWT_SECRET=replace-with-a-strong-base64-or-random-secret-at-least-32-bytes
JWT_EXPIRATION_MS=604800000

# Admin
# Any account created with this email (email/password or Google) will receive ADMIN role.
# Set this before creating the first admin account.
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
DATA_INITIALIZER_ENABLED=true

# Google OAuth
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Email / SMTP
SMTP_HOST=your-smtp-host
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_AUTH=true
SMTP_STARTTLS_ENABLE=true
SMTP_FROM=no-reply@vivuplan.xyz
SMTP_FROM_NAME=VivuPlan
APP_FRONTEND_URL=http://localhost:3000
REGISTRATION_OTP_EXPIRY_MINUTES=10
REGISTRATION_OTP_CLEANUP_SCAN_MS=10800000

# AI providers
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_PLAN_MAX_OUTPUT_TOKENS=32768
GEMINI_PLAN_THINKING_BUDGET=8192
GEMINI_REGENERATE_MAX_OUTPUT_TOKENS=24576
GEMINI_REGENERATE_THINKING_BUDGET=6144
GEMINI_SUGGESTION_MAX_OUTPUT_TOKENS=4096
GEMINI_SUGGESTION_THINKING_BUDGET=1536
GEMINI_INPUT_USD_PER_1M=0.30
GEMINI_OUTPUT_USD_PER_1M=2.50
AI_COST_USD_TO_VND_RATE=26400
AI_DESTINATION_SUGGEST_COOLDOWN_SECONDS=60
AI_DESTINATION_SUGGEST_CACHE_TTL_HOURS=24
ACTIVITY_GEOCODE_ENABLED=true
ACTIVITY_GEOCODE_NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org/search
ACTIVITY_GEOCODE_TIMEOUT_MS=3000
ACTIVITY_GEOCODE_MAX_PER_TRIP=20
ACTIVITY_GEOCODE_MIN_REQUEST_INTERVAL_MS=1000

# SePay billing
SEPAY_WEBHOOK_SECRET=your-sepay-hmac-secret
SEPAY_QR_URL_TEMPLATE=https://qr.sepay.vn/img?bank={bank}&acc={account}&amount={amount}&des={description}&template=compact
SEPAY_BANK_CODE=your-bank-code
SEPAY_ACCOUNT_NUMBER=your-bank-account-number
SEPAY_ACCOUNT_NAME=VivuPlan
SEPAY_ORDER_PREFIX=VP
BILLING_ORDER_EXPIRY_MINUTES=30
BILLING_ORDER_EXPIRY_SCAN_MS=10800000
